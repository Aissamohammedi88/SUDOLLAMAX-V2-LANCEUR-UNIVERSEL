#!/bin/bash
# ============================================================
# SUDOLLAMAX — INSPECTION + INSTALLATION AUTO
# ============================================================

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'
info(){ echo -e "${GREEN}[OK]${NC} $1"; }
warn(){ echo -e "${YELLOW}[ATTENTION]${NC} $1"; }
fail(){ echo -e "${RED}[ERREUR]${NC} $1"; }
section(){ echo -e "\n${BLUE}===== $1 =====${NC}"; }

BASE="$HOME/sudollamax_ultimate"
VENV="$BASE/venv"
MODELS="$BASE/models"

# ─── 1. INSPECTION DU DOSSIER ────────────────────────────────────

section "1. INSPECTION DU DOSSIER"

if [ ! -d "$BASE" ]; then
    fail "Dossier $BASE introuvable"
    exit 1
fi

info "Dossier : $BASE"
info "Fichiers : $(find "$BASE" -maxdepth 2 -type f | wc -l)"
info "Dossiers : $(find "$BASE" -maxdepth 2 -type d | wc -l)"

echo ""
echo "--- Contenu du dossier ---"
ls -la "$BASE"

# ─── 2. VÉRIFICATION PYTHON ─────────────────────────────────────

section "2. VÉRIFICATION PYTHON"

if command -v python3 >/dev/null 2>&1; then
    info "Python : $(python3 --version 2>&1)"
else
    fail "Python3 introuvable"
    exit 1
fi

# ─── 3. VÉRIFICATION ENVIRONNEMENT VIRTUEL ──────────────────────

section "3. ENVIRONNEMENT VIRTUEL"

if [ -d "$VENV" ]; then
    info "✅ venv trouvé"
else
    warn "venv absent — création..."
    python3 -m venv "$VENV"
    info "✅ venv créé"
fi

source "$VENV/bin/activate"

# ─── 4. VÉRIFICATION DES DÉPENDANCES PYTHON ─────────────────────

section "4. DÉPENDANCES PYTHON"

DEPENDANCES=("flask" "torch" "transformers" "requests" "fastapi" "uvicorn")

for dep in "${DEPENDANCES[@]}"; do
    if python -c "import $dep" 2>/dev/null; then
        info "$dep : OK"
    else
        warn "$dep : manquant — installation..."
        pip install "$dep"
        if python -c "import $dep" 2>/dev/null; then
            info "$dep : installé"
        else
            fail "$dep : échec installation"
        fi
    fi
done

# ─── 5. VÉRIFICATION DES MODÈLES ────────────────────────────────

section "5. MODÈLES"

if [ -d "$MODELS" ]; then
    info "Dossier models : OK"
    ls -la "$MODELS"
else
    warn "Dossier models absent — création..."
    mkdir -p "$MODELS"
    info "✅ Dossier models créé"
fi

# ─── 6. VÉRIFICATION DES SCRIPTS PYTHON ─────────────────────────

section "6. SCRIPTS PYTHON"

SCRIPTS=$(find "$BASE" -maxdepth 2 -type f -name "*.py" 2>/dev/null)

if [ -z "$SCRIPTS" ]; then
    fail "Aucun script Python trouvé"
else
    info "Scripts trouvés :"
    echo "$SCRIPTS" | while read -r s; do
        echo "   📄 $(basename "$s")"
    done
fi

# ─── 7. INSTALLATION DES OUTILS SYSTÈME ─────────────────────────

section "7. OUTILS SYSTÈME"

for outil in git curl wget tar lzma; do
    if command -v "$outil" >/dev/null 2>&1; then
        info "$outil : OK"
    else
        warn "$outil : manquant — installation..."
        sudo apt install -y "$outil"
    fi
done

# ─── 8. RAPPORT FINAL ───────────────────────────────────────────

section "8. RAPPORT FINAL"

echo "=== RAPPORT SUDOLLAMAX ==="
echo "Dossier : $BASE"
echo "Python : $(python3 --version 2>&1)"
echo "venv : $([ -d "$VENV" ] && echo OK || echo ABSENT)"
echo "models : $([ -d "$MODELS" ] && echo OK || echo ABSENT)"
echo "Scripts Python : $(find "$BASE" -maxdepth 2 -name "*.py" | wc -l)"
echo "Dépendances installées : $(pip list 2>/dev/null | wc -l)"

info "Inspection et installation terminées"
